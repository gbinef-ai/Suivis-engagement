rules_version = '2';

// ---------------------------------------------------------------------------
// Règles de sécurité — application Engagements & trésorerie, Groupe Toguna
//
// Principe : seules les adresses e-mail listées ci-dessous accèdent aux
// données. Pour ajouter un collaborateur, ajoutez son adresse dans
// utilisateurs(), puis redéployez :  firebase deploy --only firestore:rules
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // Toutes les personnes autorisées à ouvrir l'application
    function utilisateurs() {
      return [
        'adresse.tresorier@exemple.com',
        'collaborateur1@exemple.com',
        'collaborateur2@exemple.com'
      ];
    }

    // Sous-ensemble autorisé à modifier les habilitations et à restaurer
    function administrateurs() {
      return [
        'adresse.tresorier@exemple.com'
      ];
    }

    function connecte() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function autorise() {
      return connecte() && request.auth.token.email.lower() in utilisateurs();
    }
    function admin() {
      return connecte() && request.auth.token.email.lower() in administrateurs();
    }

    // Engagements : lecture et écriture pour les utilisateurs autorisés
    match /engagements/{mois} {
      allow read, write: if autorise();
    }

    // Référentiels : listes et taux modifiables par tous les autorisés,
    // habilitations réservées aux administrateurs
    match /referentiels/{document} {
      allow read:  if autorise();
      allow write: if document == 'roles' ? admin() : autorise();
    }

    // Journal : ajout et consultation autorisés, suppression interdite à tous
    match /journal/{mois} {
      allow read, create, update: if autorise();
      allow delete: if false;
    }

    // Tout le reste est fermé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
